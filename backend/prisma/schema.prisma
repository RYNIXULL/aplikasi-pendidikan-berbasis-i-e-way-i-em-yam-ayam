generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// Enums
// =========================

enum UserRole {
  TEACHER
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DocumentFormat {
  PDF
  DOCX
  PPTX
}

enum DocumentStatus {
  UPLOADED
  VALIDATING
  EXTRACTING
  PROCESSING
  ANALYZED
  READY
  REQUIRES_REVIEW
  FAILED
}

enum ContentType {
  SUMMARY
  QUIZ
  PRESENTATION
  FLASHCARDS
  MIND_MAP
  WORKSHEET
  GAME
}

enum GameType {
  QUIZ_BATTLE
  WORD_MATCHING
  TRUE_FALSE
  MEMORY_CARDS
  CROSSWORD
  WORD_PUZZLE
}

enum JobStatus {
  QUEUED
  RUNNING
  VALIDATING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum VersionOrigin {
  AI_GENERATED
  TEACHER_EDITED
  AI_REGENERATED
  RESTORED
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  REMOVED
}

enum AssessmentType {
  SELF_QUIZ
  ASSIGNMENT
  SCHEDULED_EXAM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// =========================
// Domain A: Users & Auth (5 Tables)
// =========================

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile             UserProfile?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  documents           Document[]
  generationJobs      GenerationJob[]
  generatedContents   GeneratedContent[]   @relation("TeacherContents")
  approvedContents    GeneratedContent[]   @relation("ApprovedContents")
  createdVersions     GenerationVersion[]
  aiUsageLogs         AiUsageLog[]
  classrooms          Classroom[]
  memberships         ClassroomMember[]
  publishedMaterials  ClassroomMaterial[]
  assessments         Assessment[]
  attempts            AssessmentAttempt[]  @relation("StudentAttempts")
  gradedAttempts      AssessmentAttempt[]  @relation("GradedAttempts")
  studentProgress     StudentProgress[]
  gameSessions        GameSession[]
  learningActivities  LearningActivity[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model UserProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(150)
  displayName      String?  @map("display_name") @db.VarChar(80)
  avatarStorageKey String?  @map("avatar_storage_key") @db.VarChar(512)
  institutionName  String?  @map("institution_name") @db.VarChar(150)
  subjectSpecialty String?  @map("subject_specialty") @db.VarChar(120)
  gradeLevel       String?  @map("grade_level") @db.VarChar(60)
  bio              String?
  preferredLocale  String   @default("id") @map("preferred_locale") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  deviceName        String?   @map("device_name") @db.VarChar(120)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesTokens  RefreshToken[] @relation("TokenReplacement")

  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_active")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_pwd_reset_user")
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  requestId   String?  @map("request_id") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_audit_actor_time")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

// =========================
// Domain B: Document Intelligence (4 Tables)
// =========================

model Document {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId          String         @map("teacher_id") @db.Uuid
  title              String         @db.VarChar(200)
  description        String?
  subject            String         @db.VarChar(100)
  topic              String?        @db.VarChar(150)
  originalFilename   String         @map("original_filename") @db.VarChar(255)
  fileFormat         DocumentFormat @map("file_format")
  mimeType           String         @map("mime_type") @db.VarChar(120)
  fileSizeBytes      BigInt         @map("file_size_bytes")
  sha256Checksum     String         @map("sha256_checksum") @db.Char(64)
  storageBucket      String         @map("storage_bucket") @db.VarChar(100)
  storageKey         String         @unique @map("storage_key") @db.VarChar(512)
  pageCount          Int?           @map("page_count")
  wordCount          Int?           @map("word_count")
  status             DocumentStatus @default(UPLOADED)
  processingProgress Int            @default(0) @map("processing_progress") @db.SmallInt
  failureCode        String?        @map("failure_code") @db.VarChar(60)
  failureMessage     String?        @map("failure_message")
  processedAt        DateTime?      @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  teacher           User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  pages             DocumentPage[]
  chunks            DocumentChunk[]
  analyses          DocumentAnalysis[]
  generationJobs    GenerationJob[]
  generatedContents GeneratedContent[]
  aiUsageLogs       AiUsageLog[]

  @@index([teacherId, createdAt(sort: Desc)], map: "idx_documents_teacher_active")
  @@index([teacherId, subject], map: "idx_documents_teacher_subject")
  @@index([teacherId, sha256Checksum], map: "idx_documents_sha256")
  @@map("documents")
}

model DocumentPage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  pageNumber       Int      @map("page_number")
  heading          String?  @db.VarChar(255)
  rawText          String   @map("raw_text")
  normalizedText   String   @map("normalized_text")
  extractionMethod String   @map("extraction_method") @db.VarChar(30)
  charCount        Int      @map("char_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentChunk {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String                 @map("document_id") @db.Uuid
  chunkIndex   Int                    @map("chunk_index")
  chapterTitle String?                @map("chapter_title") @db.VarChar(255)
  sectionTitle String?                @map("section_title") @db.VarChar(255)
  pageStart    Int                    @map("page_start")
  pageEnd      Int                    @map("page_end")
  tokenCount   Int                    @map("token_count")
  content      String
  embedding    Unsupported("vector(768)")?
  metadata     Json                   @default("{}")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@map("document_chunks")
}

model DocumentAnalysis {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId         String   @map("document_id") @db.Uuid
  documentSha256     String   @map("document_sha256") @db.Char(64)
  detectedSubject    String   @map("detected_subject") @db.VarChar(120)
  mainTopic          String   @map("main_topic") @db.VarChar(255)
  language           String   @default("id") @db.VarChar(16)
  subtopics          Json
  keyConcepts        Json     @map("key_concepts")
  definitions        Json
  learningObjectives Json     @map("learning_objectives")
  chapterStructure   Json     @map("chapter_structure")
  modelName          String   @map("model_name") @db.VarChar(80)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentSha256])
  @@map("document_analyses")
}

// =========================
// Domain C: AI Generation, Versioning & Usage (4 Tables)
// =========================

model GenerationJob {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId      String      @map("teacher_id") @db.Uuid
  documentId     String      @map("document_id") @db.Uuid
  contentType    ContentType @map("content_type")
  gameType       GameType?   @map("game_type")
  idempotencyKey String?     @map("idempotency_key") @db.VarChar(100)
  bullJobId      String?     @map("bull_job_id") @db.VarChar(100)
  requestConfig  Json        @map("request_config")
  status         JobStatus   @default(QUEUED)
  progress       Int         @default(0) @db.SmallInt
  attemptCount   Int         @default(0) @map("attempt_count") @db.SmallInt
  errorCode      String?     @map("error_code") @db.VarChar(60)
  errorMessage   String?     @map("error_message")
  startedAt      DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher          User              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent?
  aiUsageLogs      AiUsageLog[]

  @@index([teacherId, status, createdAt(sort: Desc)], map: "idx_gen_jobs_teacher_status")
  @@map("generation_jobs")
}

model GeneratedContent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId         String        @map("teacher_id") @db.Uuid
  documentId        String        @map("document_id") @db.Uuid
  generationJobId   String?       @unique @map("generation_job_id") @db.Uuid
  contentType       ContentType   @map("content_type")
  gameType          GameType?     @map("game_type")
  title             String        @db.VarChar(255)
  subject           String?       @db.VarChar(100)
  status            ContentStatus @default(DRAFT)
  currentVersionId  String?       @map("current_version_id") @db.Uuid
  approvedVersionId String?       @map("approved_version_id") @db.Uuid
  approvedBy        String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz(6)
  exportStorageKey  String?       @map("export_storage_key") @db.VarChar(512)
  exportGeneratedAt DateTime?     @map("export_generated_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  teacher            User                @relation("TeacherContents", fields: [teacherId], references: [id], onDelete: Restrict)
  approver           User?               @relation("ApprovedContents", fields: [approvedBy], references: [id], onDelete: SetNull)
  document           Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  generationJob      GenerationJob?      @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  versions           GenerationVersion[]
  classroomMaterials ClassroomMaterial[]
  assessments        Assessment[]

  @@index([teacherId, contentType, status], map: "idx_contents_teacher_active")
  @@index([documentId], map: "idx_contents_document")
  @@map("generated_contents")
}

model GenerationVersion {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId        String        @map("content_id") @db.Uuid
  versionNumber    Int           @map("version_number")
  createdBy        String        @map("created_by") @db.Uuid
  origin           VersionOrigin
  changeNote       String?       @map("change_note") @db.VarChar(255)
  payload          Json
  sourceReferences Json          @default("[]") @map("source_references")
  validationReport Json          @default("{}") @map("validation_report")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  content            GeneratedContent    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author             User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  publishedMaterials ClassroomMaterial[]

  @@unique([contentId, versionNumber])
  @@map("generation_versions")
}

model AiUsageLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  documentId       String?  @map("document_id") @db.Uuid
  generationJobId  String?  @map("generation_job_id") @db.Uuid
  operation        String   @db.VarChar(60)
  provider         String   @db.VarChar(40)
  model            String   @db.VarChar(80)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  estimatedCostUsd Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int      @default(0) @map("latency_ms")
  success          Boolean
  errorCode        String?  @map("error_code") @db.VarChar(60)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "idx_ai_usage_user_date")
  @@map("ai_usage_logs")
}

// =========================
// Domain D: Classrooms (3 Tables)
// =========================

model Classroom {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId       String          @map("teacher_id") @db.Uuid
  name            String          @db.VarChar(150)
  subject         String          @db.VarChar(100)
  gradeLevel      String?         @map("grade_level") @db.VarChar(60)
  description     String?
  joinCode        String          @map("join_code") @db.VarChar(12)
  joinCodeEnabled Boolean         @default(true) @map("join_code_enabled")
  status          ClassroomStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  teacher            User                @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  members            ClassroomMember[]
  materials          ClassroomMaterial[]
  assessments        Assessment[]
  studentProgress    StudentProgress[]
  gameSessions       GameSession[]
  learningActivities LearningActivity[]
  analytics          LearningAnalytics[]

  @@index([teacherId, status], map: "idx_classrooms_teacher")
  @@map("classrooms")
}

model ClassroomMember {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId String       @map("classroom_id") @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([studentId], map: "idx_members_student_active")
  @@map("classroom_members")
}

model ClassroomMaterial {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId        String   @map("classroom_id") @db.Uuid
  contentId          String   @map("content_id") @db.Uuid
  publishedVersionId String   @map("published_version_id") @db.Uuid
  publishedBy        String   @map("published_by") @db.Uuid
  title              String   @db.VarChar(255)
  description        String?
  displayOrder       Int      @default(0) @map("display_order")
  isVisible          Boolean  @default(true) @map("is_visible")
  publishedAt        DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classroom        Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  content          GeneratedContent  @relation(fields: [contentId], references: [id], onDelete: Restrict)
  publishedVersion GenerationVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)
  publisher        User              @relation(fields: [publishedBy], references: [id], onDelete: Restrict)
  studentProgress  StudentProgress[]
  gameSessions     GameSession[]

  @@unique([classroomId, contentId])
  @@index([classroomId, isVisible, displayOrder], map: "idx_classroom_materials_order")
  @@map("classroom_materials")
}

// =========================
// Domain E: Assessments (4 Tables)
// =========================

model Assessment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId      String           @map("classroom_id") @db.Uuid
  teacherId        String           @map("teacher_id") @db.Uuid
  sourceContentId  String?          @map("source_content_id") @db.Uuid
  title            String           @db.VarChar(255)
  instructions     String?
  assessmentType   AssessmentType   @map("assessment_type")
  status           AssessmentStatus @default(DRAFT)
  timeLimitSeconds Int?             @map("time_limit_seconds")
  maxAttempts      Int              @default(1) @map("max_attempts") @db.SmallInt
  passingScore     Decimal          @default(70.00) @map("passing_score") @db.Decimal(5, 2)
  totalPoints      Decimal          @default(0) @map("total_points") @db.Decimal(7, 2)
  shuffleQuestions Boolean          @default(false) @map("shuffle_questions")
  showExplanations Boolean          @default(true) @map("show_explanations")
  availableFrom    DateTime?        @map("available_from") @db.Timestamptz(6)
  availableUntil   DateTime?        @map("available_until") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  classroom     Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher       User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  sourceContent GeneratedContent?    @relation(fields: [sourceContentId], references: [id], onDelete: SetNull)
  questions     AssessmentQuestion[]
  attempts      AssessmentAttempt[]
  analytics     LearningAnalytics[]

  @@index([classroomId, status], map: "idx_assessments_classroom_status")
  @@map("assessments")
}

model AssessmentQuestion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId    String          @map("assessment_id") @db.Uuid
  questionOrder   Int             @map("question_order")
  questionType    QuestionType    @map("question_type")
  difficulty      DifficultyLevel @default(MEDIUM)
  prompt          String
  options         Json?
  correctAnswer   String          @map("correct_answer")
  explanation     String?
  points          Decimal         @default(10.00) @db.Decimal(6, 2)
  sourceReference Json?           @map("source_reference")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@unique([assessmentId, questionOrder])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId  String        @map("assessment_id") @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  attemptNumber Int           @map("attempt_number") @db.SmallInt
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt     DateTime?     @map("expires_at") @db.Timestamptz(6)
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz(6)
  gradedAt      DateTime?     @map("graded_at") @db.Timestamptz(6)
  gradedBy      String?       @map("graded_by") @db.Uuid
  autoScore     Decimal       @default(0) @map("auto_score") @db.Decimal(7, 2)
  manualScore   Decimal       @default(0) @map("manual_score") @db.Decimal(7, 2)
  totalScore    Decimal       @default(0) @map("total_score") @db.Decimal(7, 2)
  percentage    Decimal       @default(0) @db.Decimal(5, 2)
  passed        Boolean?

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    User               @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Restrict)
  grader     User?              @relation("GradedAttempts", fields: [gradedBy], references: [id], onDelete: SetNull)
  answers    AssessmentAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, startedAt(sort: Desc)], map: "idx_attempts_student")
  @@index([assessmentId, status], map: "idx_attempts_assessment_status")
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId             String   @map("attempt_id") @db.Uuid
  questionId            String   @map("question_id") @db.Uuid
  studentAnswer         String?  @map("student_answer")
  isCorrect             Boolean? @map("is_correct")
  awardedPoints         Decimal  @default(0) @map("awarded_points") @db.Decimal(6, 2)
  requiresManualGrading Boolean  @default(false) @map("requires_manual_grading")
  teacherFeedback       String?  @map("teacher_feedback")
  answeredAt            DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("assessment_answers")
}

// =========================
// Domain F: Progress, Games & Analytics (4 Tables)
// =========================

model StudentProgress {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String         @map("student_id") @db.Uuid
  classroomId          String         @map("classroom_id") @db.Uuid
  materialId           String         @map("material_id") @db.Uuid
  status               ProgressStatus @default(NOT_STARTED)
  completionPercentage Int            @default(0) @map("completion_percentage") @db.SmallInt
  timeSpentSeconds     Int            @default(0) @map("time_spent_seconds")
  lastAccessedAt       DateTime?      @map("last_accessed_at") @db.Timestamptz(6)
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  material  ClassroomMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([studentId, classroomId], map: "idx_progress_student_classroom")
  @@map("student_progress")
}

model GameSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  classroomId        String   @map("classroom_id") @db.Uuid
  materialId         String   @map("material_id") @db.Uuid
  gameType           GameType @map("game_type")
  score              Int
  maxScore           Int      @map("max_score")
  accuracyPercentage Decimal  @map("accuracy_percentage") @db.Decimal(5, 2)
  durationSeconds    Int      @map("duration_seconds")
  streakMax          Int      @default(0) @map("streak_max")
  completed          Boolean  @default(true)
  sessionSummary     Json     @default("{}") @map("session_summary")
  playedAt           DateTime @default(now()) @map("played_at") @db.Timestamptz(6)

  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  material  ClassroomMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, score(sort: Desc), durationSeconds(sort: Asc)], map: "idx_game_sessions_leaderboard")
  @@index([studentId, playedAt(sort: Desc)], map: "idx_game_sessions_student")
  @@map("game_sessions")
}

model LearningActivity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  classroomId   String?  @map("classroom_id") @db.Uuid
  activityType  String   @map("activity_type") @db.VarChar(60)
  referenceType String?  @map("reference_type") @db.VarChar(40)
  referenceId   String?  @map("reference_id") @db.Uuid
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([studentId, occurredAt(sort: Desc)], map: "idx_learning_activities_student_time")
  @@map("learning_activities")
}

model LearningAnalytics {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId       String   @map("classroom_id") @db.Uuid
  assessmentId      String?  @map("assessment_id") @db.Uuid
  metricScope       String   @map("metric_scope") @db.VarChar(40)
  totalStudents     Int      @default(0) @map("total_students")
  completionRate    Decimal  @default(0) @map("completion_rate") @db.Decimal(5, 2)
  averageScore      Decimal  @default(0) @map("average_score") @db.Decimal(5, 2)
  scoreDistribution Json     @default("{}") @map("score_distribution")
  questionItemStats Json     @default("[]") @map("question_item_stats")
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  classroom  Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([classroomId, metricScope, computedAt(sort: Desc)], map: "idx_analytics_classroom_scope")
  @@map("learning_analytics")
}
