# Node.js Backend Environment Template
# Copy to .env for local development. Never commit real credentials.

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql://edu_ai_user:YOUR_POSTGRES_PASSWORD@localhost:5432/edu_ai_db?schema=public
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=edu-ai-private
S3_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
S3_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_PEPPER=YOUR_JWT_REFRESH_PEPPER_MIN_32_CHARS
JWT_REFRESH_EXPIRES_DAYS=30

AI_SERVICE_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN_MIN_32_CHARS
INTERNAL_HMAC_SECRET=YOUR_INTERNAL_HMAC_SECRET_MIN_32_CHARS

AI_DAILY_JOB_QUOTA=50
AI_DAILY_TOKEN_QUOTA=500000
MAX_UPLOAD_BYTES=26214400
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
