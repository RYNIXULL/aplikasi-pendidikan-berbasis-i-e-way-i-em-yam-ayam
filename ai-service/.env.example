# Python AI Processing Service Environment Template
# Copy to .env for local development. Never commit real credentials.

APP_ENV=development
PORT=8000

INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN_MIN_32_CHARS
INTERNAL_HMAC_SECRET=YOUR_INTERNAL_HMAC_SECRET_MIN_32_CHARS

AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_QUALITY=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

OCR_ENABLED=false
