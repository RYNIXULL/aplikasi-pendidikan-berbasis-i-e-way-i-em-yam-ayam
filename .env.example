# Root Docker Compose Environment Template
# Copy to .env for local development ONLY. Never commit real .env files.

# PostgreSQL 16 + pgvector
POSTGRES_DB=edu_ai_db
POSTGRES_USER=edu_ai_user
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Redis 7
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# MinIO (S3-Compatible Local Storage)
MINIO_ROOT_USER=YOUR_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=YOUR_MINIO_SECRET_KEY
S3_BUCKET_NAME=edu-ai-private

# Node.js Backend
NODE_ENV=development
BACKEND_PORT=3000
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_PEPPER=YOUR_JWT_REFRESH_PEPPER_MIN_32_CHARS
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN_MIN_32_CHARS
INTERNAL_HMAC_SECRET=YOUR_INTERNAL_HMAC_SECRET_MIN_32_CHARS

# Python AI Processing Service
APP_ENV=development
AI_SERVICE_PORT=8000
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_QUALITY=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OCR_ENABLED=false
